FROM node:20-trixie-slim

WORKDIR /app

COPY package*.json tsconfig.json jest.config.js ./
RUN npm ci

COPY src ./src
COPY tests ./tests
COPY swagger ./swagger

ENV NODE_ENV=test
ENV DB_PATH=:memory:
ENV API_KEY=test-api-key
ENV CMC_API_KEY=test-cmc-key
ENV CMC_QUOTE_CURRENCY=USD
ENV CMC_BASE_URL=https://pro-api.coinmarketcap.com
ENV CMC_TIMEOUT=5000

CMD ["npx", "jest", "--runInBand", "--coverage"]